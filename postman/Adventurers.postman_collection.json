  "item": [
    {
      "name": "Attributes",
      "item": [
        {
          "name": "attributes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var resp = pm.response",
                  "var jsonData = resp.json()",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    resp.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 1s\", function () {",
                  "    pm.expect(resp.responseTime).to.be.below(1000);",
                  "",
                  "});",
                  "",
                  "pm.test(\"Body matches string\", function () {",
                  "    pm.expect(resp.text()).to.include(\"Athletics\");",
                  "});",
                  "",
                  "pm.test(\"The first attribute should be Strength\", function () {",
                  "    pm.expect(jsonData[0].name).to.eql(\"Strength\");",
                  "});",
                  "",
                  "pm.test(\"Validate Strength\", function() {",
                  "    pm.expect(jsonData[0].id).to.eql(1);",
                  "    pm.expect(jsonData[0].name).to.eql(\"Strength\");",
                  "    pm.expect(jsonData[0].shortname).to.eql(\"STR\");",
                  "    pm.expect(jsonData[0].description).to.eql(\"Measures physical power, carrying capacity, and effectiveness in brute-force actions such as lifting, pushing, and melee attacks.\");",
                  "})",
                  "",
                  "pm.test(\"Validate Dexterity\", function() {",
                  "    pm.expect(jsonData[1].name).to.eql(\"Dexterity\")",
                  "    pm.expect(jsonData[1].shortname).to.eql(\"DEX\");",
                  "    pm.expect(jsonData[1].description).includes(\"reflexes\")",
                  "    pm.expect(jsonData[1].description).includes(\"precision\")",
                  "    pm.expect(jsonData[1].skills.length).to.eql(3) ",
                  "    pm.expect(jsonData[1].skills[2]).eqls(\"Stealth\")",
                  "})",
                  "",
                  "pm.test(\"Validate Constitution\", function() {",
                  "    pm.expect(jsonData[2].name).eqls(\"Constitution\")",
                  "    pm.expect(jsonData[2].shortname).eqls(\"CON\")",
                  "    pm.expect(jsonData[2].description).includes(\"endurance\")",
                  "    pm.expect(jsonData[2].description).includes(\"physical toughness\")",
                  "    pm.expect(jsonData[2].skills.length).to.eql(0)",
                  "})",
                  "",
                  "pm.test(\"Validate Intelligence\", function() {",
                  "    pm.expect(jsonData[3].name).eqls(\"Intelligence\")",
                  "    pm.expect(jsonData[3].shortname).eqls(\"INT\")",
                  "    pm.expect(jsonData[3].description).includes(\"analytical ability\")",
                  "    pm.expect(jsonData[3].description).includes(\"logical thinking\")",
                  "    pm.expect(jsonData[3].skills.length).to.eql(5)",
                  "    pm.expect(jsonData[3].skills[2]).to.eql(\"Investigation\")",
                  "})",
                  "",
                  "pm.test(\"Validate Wisdom\", function() {",
                  "    pm.expect(jsonData[4].name).eqls(\"Wisdom\")",
                  "    pm.expect(jsonData[4].shortname).eqls(\"WIS\")",
                  "    pm.expect(jsonData[4].description).includes(\"good judgment\")",
                  "    pm.expect(jsonData[4].description).includes(\"perception\")",
                  "    pm.expect(jsonData[4].skills.length).to.be.eql(5)",
                  "})",
                  "",
                  "pm.test(\"Validate Charisma\", function() {",
                  "    pm.expect(jsonData[5].name).to.be.eql(\"Charisma\")",
                  "    pm.expect(jsonData[5].shortname).eqls(\"CHA\")",
                  "    pm.expect(jsonData[5].description).includes(\"confidence\")",
                  "    pm.expect(jsonData[5].description).includes(\"social impact\")",
                  "    pm.expect(jsonData[5].skills).to.not.be.empty",
                  "    pm.expect(jsonData[5].skills[3]).eqls(\"Persuasion\")",
                  "    pm.expect(jsonData[5].skills[4]).undefined",
                  "})"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://{{BASE_FQDN}}/api/attributes",
              "protocol": "https",
              "host": [
                "{{BASE_FQDN}}"
              ],
              "path": [
                "api",
                "attributes"
              ]
            }
          },
          "response": []
        }
      ]
